#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
TailRouter CLI (Python Edition v1.1.0)
=====================================
Zero-Dependency Pure Python Gateway for Tailscale Serve & Funnel.
"""

import json
import os
import signal
import subprocess
import sys
import time
import urllib.request
from typing import Any, Dict, Optional

VERSION = "1.1.0"
DEFAULT_PORT = 65534

BANNER = f"""
  ⚡ TailRouter Native Engine v{VERSION}
  ==================================
  Zero-Dependency Pure Python Gateway
"""


def now_str() -> str:
    return time.strftime("%Y/%m/%d %H:%M:%S")


def get_base_dir() -> str:
    # 1. Thư mục chứa chính file script này (giải mã symlink)
    script_path = os.path.realpath(__file__)
    dir_path = os.path.dirname(script_path)
    if os.path.exists(os.path.join(dir_path, "server.py")):
        return dir_path

    # 2. Biến môi trường tùy chỉnh nếu có
    env_dir = os.environ.get("TAILROUTER_DIR")
    if env_dir and os.path.exists(os.path.join(env_dir, "server.py")):
        return env_dir

    # 3. Các đường dẫn cài đặt thông dụng
    candidates = [
        os.path.expanduser("~/tailrouter-v1"),
        os.path.expanduser("~/tailrouter"),
        os.path.expanduser("~/.local/share/tailrouter"),
        "/usr/local/share/tailrouter",
        "/opt/tailrouter",
    ]
    for c in candidates:
        if os.path.exists(os.path.join(c, "server.py")):
            return c

    return dir_path


def check_server_status(port: int = DEFAULT_PORT) -> Optional[Dict[str, Any]]:
    try:
        url = f"http://127.0.0.1:{port}/api/status"
        req = urllib.request.Request(url, headers={"User-Agent": "TailRouter-CLI"})
        with urllib.request.urlopen(req, timeout=1.2) as resp:
            if resp.status == 200:
                return json.loads(resp.read().decode("utf-8"))
    except Exception:
        pass
    return None


def get_pid_from_file(base_dir: str) -> Optional[int]:
    pid_file = os.path.join(base_dir, "server.pid")
    if os.path.exists(pid_file):
        try:
            with open(pid_file, "r") as f:
                pid = int(f.read().strip())
            os.kill(pid, 0)
            return pid
        except Exception:
            pass
    return None


def find_existing_pid(port: int = DEFAULT_PORT) -> Optional[int]:
    try:
        res = subprocess.run(["ss", "-tulpn"], capture_output=True, text=True, timeout=2)
        if res.returncode == 0:
            for line in res.stdout.splitlines():
                if f":{port} " in line and "pid=" in line:
                    parts = line.split("pid=")
                    if len(parts) > 1:
                        pid_str = parts[1].split(",")[0].split(")")[0]
                        return int(pid_str)
    except Exception:
        pass

    try:
        res = subprocess.run(["lsof", "-ti", f":{port}"], capture_output=True, text=True, timeout=2)
        if res.returncode == 0 and res.stdout.strip():
            return int(res.stdout.strip().splitlines()[0])
    except Exception:
        pass

    return None


def run_or_start(foreground: bool = False) -> None:
    base_dir = get_base_dir()
    server_py = os.path.join(base_dir, "server.py")
    log_file = os.path.join(base_dir, "server.log")
    pid_file = os.path.join(base_dir, "server.pid")

    if not os.path.exists(server_py):
        print(f"❌ Không tìm thấy 'server.py' tại: {base_dir}")
        sys.exit(1)

    # 1. Kiểm tra xem cổng 65534 có đang bị chiếm dụng không
    status_data = check_server_status(DEFAULT_PORT)
    existing_pid = get_pid_from_file(base_dir) or find_existing_pid(DEFAULT_PORT)

    if status_data or existing_pid:
        pid = (status_data.get("pid") if status_data else None) or existing_pid or "đang chạy"
        print(BANNER.strip("\n"))
        print(f"⚠️  Cổng {DEFAULT_PORT} đã có tiến trình đang chạy (PID: {pid}).")
        print(f"👉 Truy cập ngay tại: http://localhost:{DEFAULT_PORT}/router")
        ts_info = (status_data.get("tailscale") if status_data else {}) or {}
        fqdn = ts_info.get("fqdn")
        if fqdn:
            print(f"👉 Tailscale Serve:   https://{fqdn}/router")
        return

    # 2. Cổng chưa bị chiếm dụng: Khởi chạy TailRouter
    print(BANNER.strip("\n"))
    print(f"[TailRouter] {now_str()} Khởi chạy TailRouter Native Engine trên cổng {DEFAULT_PORT} (Dual-Stack IPv4/IPv6)...")

    if foreground:
        try:
            os.execv(sys.executable, [sys.executable, server_py])
        except Exception as e:
            print(f"[Lỗi] {e}")
            sys.exit(1)

    # Chạy nền (daemon)
    with open(log_file, "a", encoding="utf-8") as out:
        if sys.platform != "win32":
            proc = subprocess.Popen(
                [sys.executable, server_py],
                cwd=base_dir,
                stdout=out,
                stderr=out,
                stdin=subprocess.DEVNULL,
                start_new_session=True,
            )
        else:
            proc = subprocess.Popen(
                [sys.executable, server_py],
                cwd=base_dir,
                stdout=out,
                stderr=out,
                stdin=subprocess.DEVNULL,
                creationflags=subprocess.CREATE_NEW_PROCESS_GROUP,
            )

    server_pid = proc.pid
    with open(pid_file, "w") as f:
        f.write(str(server_pid))

    # Chờ server sẵn sàng (tối đa 3 giây)
    status_data = None
    for _ in range(6):
        time.sleep(0.5)
        status_data = check_server_status(DEFAULT_PORT)
        if status_data:
            break

    # Cấu hình Tailscale serve trong background nếu có
    try:
        subprocess.run(
            ["tailscale", "serve", "--bg", "--set-path", "/router", f"http://127.0.0.1:{DEFAULT_PORT}/router"],
            capture_output=True,
            timeout=3,
        )
    except Exception:
        pass

    print(f"[TailRouter] {now_str()} TailRouter Gateway sẵn sàng tại: http://localhost:{DEFAULT_PORT}/router")
    if status_data:
        fqdn = status_data.get("tailscale", {}).get("fqdn")
        if fqdn:
            print(f"[TailRouter] {now_str()} Tailscale Serve sẵn sàng tại: https://{fqdn}/router")


def cmd_stop() -> None:
    base_dir = get_base_dir()
    pid_file = os.path.join(base_dir, "server.pid")
    pid = get_pid_from_file(base_dir) or find_existing_pid(DEFAULT_PORT)

    if not pid:
        print(BANNER.strip("\n"))
        print(f"⚠️  TailRouter Gateway hiện KHÔNG CHẠY trên cổng {DEFAULT_PORT}.")
        if os.path.exists(pid_file):
            try:
                os.remove(pid_file)
            except Exception:
                pass
        return

    print(f"🛑 Đang dừng tiến trình TailRouter (PID: {pid})...")
    try:
        os.kill(pid, signal.SIGTERM)
        for _ in range(6):
            time.sleep(0.5)
            try:
                os.kill(pid, 0)
            except OSError:
                break
        else:
            os.kill(pid, signal.SIGKILL)
    except Exception as e:
        print(f"⚠️  Lỗi khi dừng: {e}")

    if os.path.exists(pid_file):
        try:
            os.remove(pid_file)
        except Exception:
            pass

    print("✅ Đã dừng thành công dịch vụ TailRouter!")


def cmd_status() -> None:
    base_dir = get_base_dir()
    status_data = check_server_status(DEFAULT_PORT)
    pid = get_pid_from_file(base_dir) or find_existing_pid(DEFAULT_PORT)

    if not status_data and not pid:
        print(BANNER.strip("\n"))
        print(f"⚠️  TailRouter Gateway hiện KHÔNG CHẠY trên cổng {DEFAULT_PORT}.")
        print("👉 Gõ 'tailrouter' để khởi động ngay.")
        return

    print(BANNER.strip("\n"))
    print("🟢 TailRouter Gateway: Đang chạy (Active)")
    print(f"   Phiên bản: {status_data.get('version', VERSION) if status_data else VERSION}")
    print(f"   PID:       {pid or 'Đang chạy'}")
    if status_data:
        print(f"   Uptime:    {status_data.get('uptime_seconds', 0)} giây")
        print(f"   Routes:    {status_data.get('total_routes', 0)} ({status_data.get('active_routes', 0)} đang bật)")
    print(f"   Dashboard: http://localhost:{DEFAULT_PORT}/router")
    if status_data:
        ts = status_data.get("tailscale", {})
        if ts.get("fqdn"):
            print(f"   Tailscale: https://{ts.get('fqdn')}/router")


def print_help() -> None:
    print(BANNER.strip("\n"))
    print("""
Sử dụng: tailrouter [lệnh]

Các lệnh có sẵn:
  (không tham số)   Khởi chạy nhanh Gateway (hoặc báo bận nếu cổng đã có tiến trình)
  start             Khởi chạy Gateway chạy ngầm (-f để chạy foreground)
  stop              Dừng tiến trình Gateway đang chạy
  restart           Khởi động lại Gateway
  status            Kiểm tra trạng thái hoạt động của Gateway & Tailscale
  version           Xem thông tin phiên bản
  help              Hiển thị trợ giúp này
""")


def main() -> None:
    args = sys.argv[1:]
    if not args:
        run_or_start(foreground=False)
        return

    cmd = args[0].lower()
    if cmd in ["start", "run", "boot", "up"]:
        foreground = ("-f" in args[1:] or "--foreground" in args[1:])
        run_or_start(foreground=foreground)
    elif cmd in ["stop", "kill", "down"]:
        cmd_stop()
    elif cmd in ["restart", "reload"]:
        cmd_stop()
        time.sleep(1)
        run_or_start(foreground=False)
    elif cmd in ["status", "info", "st"]:
        cmd_status()
    elif cmd in ["version", "-v", "--version"]:
        print(f"TailRouter Native Engine v{VERSION}")
    elif cmd in ["help", "-h", "--help"]:
        print_help()
    else:
        print(f"Lệnh không xác định: {cmd}")
        print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
